# ==============================================================================
# LinkedIn Developer App Credentials
# Obtain from https://developer.linkedin.com (Create App -> Products: Share on LinkedIn & Sign In with OpenID)
# ==============================================================================
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback

# ==============================================================================
# Dashboard & Local Server Settings
# ==============================================================================
PORT=3000
HOST=127.0.0.1
DASHBOARD_AUTH_TOKEN=

# ==============================================================================
# Optional: Email Notifications (e.g., Post Dispatch / Error Alerts)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=

